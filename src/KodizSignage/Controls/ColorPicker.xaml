<UserControl x:Class="KodizSignage.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <!-- Swatch: opens the palette. Checkerboard underneath keeps dark colors visible. -->
        <ToggleButton x:Name="SwatchButton" Width="34" Height="30" MinHeight="0" Padding="0" Margin="0,0,8,0" Cursor="Hand"
                      ToolTip="{DynamicResource Color_Open}" Click="SwatchButton_Click">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource TextMutedBrush}" Padding="2" Background="Transparent">
                        <Grid>
                            <Border CornerRadius="4">
                                <Border.Background>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <DrawingGroup>
                                                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H2 V2 H0Z" />
                                                <GeometryDrawing Brush="#C8C8C8" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                                            </DrawingGroup>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Fill" CornerRadius="4" Background="{Binding SwatchBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Path x:Name="InvalidMark" Data="M0,0 L1,1" Stretch="Fill" Stroke="{DynamicResource DangerBrush}" StrokeThickness="2" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsTextValid, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter TargetName="InvalidMark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <TextBox x:Name="HexBox" Width="96" VerticalContentAlignment="Center" MaxLength="7" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                 TextChanged="HexBox_TextChanged" LostKeyboardFocus="HexBox_LostKeyboardFocus" ToolTip="{DynamicResource Color_HexHint}" />

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="PickerPopup_Closed">
            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                    Padding="14" Margin="0,0,10,10" Width="300">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Color_Palette}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl x:Name="PaletteList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="24" MinHeight="0" Padding="0" Margin="0,0,3,3" ToolTip="{Binding}" Click="PaletteColor_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{Binding}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B" Property="BorderBrush" Value="White" />
                                                    <Setter TargetName="B" Property="BorderThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{DynamicResource Color_Custom}" FontWeight="SemiBold" Margin="0,10,0,8" />
                    <!-- Saturation (x) / brightness (y) of the chosen hue. -->
                    <Grid x:Name="SvArea" Height="150" Cursor="Cross" ClipToBounds="True"
                          MouseLeftButtonDown="SvArea_MouseDown" MouseMove="SvArea_MouseMove" MouseLeftButtonUp="SvArea_MouseUp">
                        <Rectangle x:Name="HueFill" Fill="Red" RadiusX="6" RadiusY="6" />
                        <Rectangle RadiusX="6" RadiusY="6">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="White" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle RadiusX="6" RadiusY="6">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="Black" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <!-- Hue -->
                    <Grid Margin="0,10,0,0" Height="18">
                        <Border CornerRadius="9" Margin="0,3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0" />
                                    <GradientStop Color="#FFFF00" Offset="0.1667" />
                                    <GradientStop Color="#00FF00" Offset="0.3333" />
                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                    <GradientStop Color="#0000FF" Offset="0.6667" />
                                    <GradientStop Color="#FF00FF" Offset="0.8333" />
                                    <GradientStop Color="#FF0000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Slider x:Name="HueSlider" Minimum="0" Maximum="360" ValueChanged="HueSlider_ValueChanged" VerticalAlignment="Center"
                                ToolTip="{DynamicResource Color_Hue}" Background="Transparent" />
                    </Grid>

                    <!-- RGB -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="34" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="R" VerticalAlignment="Center" Foreground="#F87171" FontWeight="SemiBold" />
                        <Slider x:Name="RSlider" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="Rgb_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=RSlider, StringFormat=0}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" Foreground="#4ADE80" FontWeight="SemiBold" />
                        <Slider x:Name="GSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="Rgb_ValueChanged" VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=GSlider, StringFormat=0}" TextAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" Foreground="#60A5FA" FontWeight="SemiBold" />
                        <Slider x:Name="BSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="Rgb_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=BSlider, StringFormat=0}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Before / after -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="OldSwatch" Height="30" CornerRadius="6,0,0,6" Cursor="Hand" ToolTip="{DynamicResource Color_Revert}" MouseLeftButtonUp="OldSwatch_Click" />
                        <Border x:Name="NewSwatch" Grid.Column="1" Height="30" CornerRadius="0,6,6,0" />
                        <Button Grid.Column="2" Content="{DynamicResource Color_Done}" Margin="10,0,0,0" MinWidth="70" Click="Done_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
