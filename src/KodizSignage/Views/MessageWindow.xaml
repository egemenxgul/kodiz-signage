<Window x:Class="KodizSignage.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Topmost="True" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="24,22,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top" Margin="0,0,16,0">
            <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="18" />
        </Border>
        <ScrollViewer Grid.Column="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="MessageText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                     MinHeight="0" VerticalContentAlignment="Top" Margin="0,8,0,0" />
        </ScrollViewer>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="SecondaryButton" MinWidth="110" Margin="0,0,8,0" IsCancel="True" Click="Secondary_Click" />
            <Button x:Name="PrimaryButton" MinWidth="110" Style="{StaticResource AccentButton}" IsDefault="True" Click="Primary_Click" />
        </StackPanel>
    </Grid>
</Window>
