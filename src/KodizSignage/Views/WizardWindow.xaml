<Window x:Class="KodizSignage.Views.WizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kodiz Signage" Width="640" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step dots -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Ellipse x:Name="Dot1" Width="9" Height="9" Margin="4,0" />
            <Ellipse x:Name="Dot2" Width="9" Height="9" Margin="4,0" />
            <Ellipse x:Name="Dot3" Width="9" Height="9" Margin="4,0" />
        </StackPanel>

        <!-- 1: language -->
        <StackPanel x:Name="Page1" Grid.Row="1" VerticalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0" />
                        <GradientStop Color="#14B8A6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Path Data="M 0,0 L 20,12 L 0,24 Z" Fill="White" Margin="6,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{DynamicResource Wizard_Welcome}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="{DynamicResource Wizard_WelcomeText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,24" MaxWidth="460" />
            <TextBlock Text="{DynamicResource Wizard_Language}" HorizontalAlignment="Center" Margin="0,0,0,10" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="TurkishButton" Content="Türkçe" MinWidth="140" Height="40" Margin="0,0,10,0" Click="Turkish_Click" />
                <Button x:Name="EnglishButton" Content="English" MinWidth="140" Height="40" Click="English_Click" />
            </StackPanel>
        </StackPanel>

        <!-- 2: screens -->
        <StackPanel x:Name="Page2" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Wizard_ScreensTitle}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="ScreensText" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,16" />
            <ItemsControl x:Name="DisplayList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                            <CheckBox IsChecked="{Binding Use}">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="12" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox x:Name="SameContentBox" Content="{DynamicResource Wizard_SameContent}" IsChecked="True" Margin="0,8,0,0" />
            <TextBlock Text="{DynamicResource Wizard_ScreensLater}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>

        <!-- 3: content & startup -->
        <StackPanel x:Name="Page3" Grid.Row="1" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Wizard_ContentTitle}" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource Wizard_ContentText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,16" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource AccentButton}" Click="AddMedia_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Media_AddFiles}" />
                    </StackPanel>
                </Button>
                <Button Click="CreateSlide_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Slide_CreateButton}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="MediaCountText" FontWeight="SemiBold" Margin="0,12,0,0" />
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <CheckBox x:Name="AutostartBox" Content="{DynamicResource Wizard_Autostart}" />
                    <CheckBox x:Name="AutoplayBox" Content="{DynamicResource Wizard_Autoplay}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="{DynamicResource Wizard_Shortcut}" Style="{StaticResource Secondary}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="SkipButton" Content="{DynamicResource Wizard_Skip}" HorizontalAlignment="Left" Click="Skip_Click" Background="Transparent" BorderThickness="0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="{DynamicResource Wizard_Back}" MinWidth="100" Margin="0,0,8,0" Click="Back_Click" />
                <Button x:Name="NextButton" Style="{StaticResource AccentButton}" MinWidth="140" Click="Next_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
