<UserControl x:Class="KodizSignage.Views.Tabs.GeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KodizSignage.ViewModels"
             xmlns:conv="clr-namespace:KodizSignage.Converters"
             xmlns:ctl="clr-namespace:KodizSignage.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource Settings_AutoSaved}" Style="{StaticResource Secondary}" Margin="0,0,0,16" />

            <!-- Playback -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource General_SectionPlayback}" Style="{StaticResource H2}" />
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource General_DefaultDuration}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBox Grid.Column="1" Text="{Binding DefaultImageDuration, UpdateSourceTrigger=PropertyChanged, Delay=700}" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource General_Transition}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Transitions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Transition}" />
                    </Grid>
                    <Grid IsEnabled="{Binding IsFade}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource General_TransitionDuration}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0.1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="{Binding TransitionDuration}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding TransitionDuration, StringFormat={}{0:0.0} s}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Motion_Title}" />
                            <TextBlock Text="{DynamicResource Motion_Hint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Motions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding ImageMotion}" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Opening hours -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Hours_Title}" Style="{StaticResource H2}" />
                    <TextBlock Text="{DynamicResource Hours_Description}" Style="{StaticResource Secondary}" Margin="0,0,0,12" />
                    <CheckBox Content="{DynamicResource Hours_Enabled}" IsChecked="{Binding OperatingHoursEnabled}" Margin="0,0,0,12" />
                    <StackPanel IsEnabled="{Binding OperatingHoursEnabled}">
                        <ContentControl Content="{Binding OpeningHours}" ContentTemplate="{StaticResource ScheduleEditorTemplate}" MaxWidth="420" HorizontalAlignment="Left" />
                        <CheckBox Content="{DynamicResource Hours_AllowDisplaySleep}" IsChecked="{Binding AllowDisplaySleep}" Margin="0,12,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource General_SectionAppearance}" Style="{StaticResource H2}" />
                    <Grid Margin="0,4,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource General_Scaling}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ScalingModes}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Scaling}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource General_Background}" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource General_InvalidColor}" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,4,0,0"
                                       Visibility="{Binding IsBackgroundColorValid, Converter={StaticResource InvBoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding ColorPresets}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" MinHeight="0" Padding="0" Margin="0,0,6,0" ToolTip="{Binding}"
                                                Background="{Binding Converter={StaticResource ColorToBrush}}" BorderBrush="{DynamicResource TextMutedBrush}"
                                                Command="{Binding DataContext.PickColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ctl:ColorPicker Color="{Binding BackgroundColor}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Audio -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource General_SectionAudio}" Style="{StaticResource H2}" />
                    <CheckBox Content="{DynamicResource General_VideoSound}" IsChecked="{Binding VideoSoundEnabled}" Margin="0,4,0,12" />
                    <Grid IsEnabled="{Binding VideoSoundEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource General_Volume}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding VolumePercent}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0:0} %}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Watched folder -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Folder_Title}" Style="{StaticResource H2}" />
                    <TextBlock Text="{DynamicResource Folder_Description}" Style="{StaticResource Secondary}" Margin="0,0,0,12" />
                    <CheckBox Content="{DynamicResource Folder_Enabled}" IsChecked="{Binding WatchFolderEnabled}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding WatchFolderPath, Mode=OneWay}" IsReadOnly="True" />
                        <Button Grid.Column="1" Content="{DynamicResource Folder_Choose}" Command="{Binding ChooseWatchFolderCommand}" Margin="8,0,0,0" />
                        <Button Grid.Column="2" Content="{DynamicResource Folder_SyncNow}" Command="{Binding SyncFolderNowCommand}" Margin="8,0,0,0"
                                IsEnabled="{Binding WatchFolderEnabled}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource General_SectionSystem}" Style="{StaticResource H2}" />
                    <Grid Margin="0,4,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource General_Language}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Language}" />
                    </Grid>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource AppTheme_Title}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
                    </Grid>
                    <CheckBox Content="{DynamicResource Touch_LongPress}" IsChecked="{Binding LongPressOpensSettings}" Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource Touch_LongPressHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <CheckBox Content="{DynamicResource General_StartWithWindows}" IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8" />
                    <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding IsStartupBlocked, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Startup_Blocked}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="{DynamicResource Startup_Fix}"
                                    Command="{Binding FixStartupCommand}" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <CheckBox Content="{DynamicResource General_AutoPlay}" IsChecked="{Binding AutoPlayOnLaunch}" />
                </StackPanel>
            </Border>

            <!-- Security -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Pin_Section}" Style="{StaticResource H2}" />
                    <TextBlock Text="{DynamicResource Pin_Description}" Style="{StaticResource Secondary}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Text" Value="&#xE785;" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPin}" Value="True">
                                            <Setter Property="Text" Value="&#xE72E;" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource Pin_Off}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPin}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource Pin_On}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Command="{Binding SetPinCommand}" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Content" Value="{DynamicResource Pin_Set}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPin}" Value="True">
                                            <Setter Property="Content" Value="{DynamicResource Pin_Change}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{DynamicResource Pin_Remove}" Command="{Binding RemovePinCommand}"
                                Visibility="{Binding HasPin, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="{Binding HasPin}">
                        <TextBlock Text="{DynamicResource Pin_AutoLock}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding AutoLockChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding PinAutoLockMinutes}" Width="180" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stats_Section}" Style="{StaticResource H2}" />
                    <TextBlock Text="{DynamicResource Stats_Description}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <!-- Chart: last 30 days -->
                    <StackPanel Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Command="{Binding RefreshStatsCommand}" Content="{DynamicResource Stats_Refresh}" />
                            <TextBlock Text="{Binding StatsSummaryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{DynamicResource Stats_Top}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding TopMedia}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StatBar}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="270" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Border Grid.Column="1" Height="16" CornerRadius="4" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Width="{Binding Size}" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{DynamicResource Stats_PerDay}" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                        <ItemsControl ItemsSource="{Binding DailyBars}" Height="84">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StatBar}">
                                    <Border Width="14" Height="{Binding Size}" Margin="0,0,4,0" CornerRadius="3,3,0,0" VerticalAlignment="Bottom"
                                            Background="{DynamicResource AccentBrush}">
                                        <Border.ToolTip>
                                            <TextBlock><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}" /></TextBlock>
                                        </Border.ToolTip>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding StatsScreensText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Stats_Empty}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"
                               Visibility="{Binding HasStats, Converter={StaticResource InvBoolToVis}}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ExportStatsCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Stats_Export}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ResetStatsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Stats_Reset}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Backup_Section}" Style="{StaticResource H2}" />
                    <TextBlock Text="{DynamicResource Backup_Description}" Style="{StaticResource Secondary}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                        <Button Command="{Binding CreateBackupCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Backup_Create}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RestoreBackupCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Backup_Restore}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BusyText}" Margin="0,0,0,6" />
                        <ProgressBar Value="{Binding BusyProgress}" Maximum="100" />
                    </StackPanel>
                    <!-- Automatic backup -->
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <CheckBox Content="{DynamicResource AutoBackup_Enabled}" IsChecked="{Binding AutoBackupEnabled}" Margin="0,0,0,10" />
                            <StackPanel IsEnabled="{Binding AutoBackupEnabled}">
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Command="{Binding PickAutoBackupFolderCommand}" Content="{DynamicResource Music_ChangeFolder}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding AutoBackupFolder, Mode=OneWay}" IsReadOnly="True" />
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <ComboBox ItemsSource="{Binding AutoBackupIntervals}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AutoBackupInterval}"
                                              Width="170" Margin="0,0,8,6" />
                                    <ComboBox ItemsSource="{Binding AutoBackupKeepChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AutoBackupKeep}"
                                              Width="200" Margin="0,0,8,6" />
                                    <Button Command="{Binding BackupNowCommand}" Content="{DynamicResource AutoBackup_Now}" Margin="0,0,0,6"
                                            IsEnabled="{Binding AutoBackupRunning, Converter={StaticResource InvBool}}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding AutoBackupStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{DynamicResource AutoBackup_Hint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
            </Border>

            <!-- Background music -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Music_Section}" Style="{StaticResource H2}" />
                    <TextBlock Text="{DynamicResource Music_Description}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <CheckBox Content="{DynamicResource Music_Enabled}" IsChecked="{Binding MusicEnabled}" Margin="0,0,0,10" />
                    <StackPanel IsEnabled="{Binding MusicEnabled}">
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Command="{Binding PickMusicFolderCommand}" Content="{DynamicResource Music_ChangeFolder}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding MusicFolder, Mode=OneWay}" IsReadOnly="True" />
                        </DockPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{DynamicResource Music_Volume}" /><Run Text=": %" /><Run Text="{Binding MusicVolumePercent, Mode=OneWay}" />
                            </TextBlock>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding MusicVolumePercent, Delay=300}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Music_During}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MusicDuringChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MusicDuring}" />
                        </Grid>
                        <CheckBox Content="{DynamicResource Music_Shuffle}" IsChecked="{Binding MusicShuffle}" Margin="0,0,0,6" />
                        <CheckBox Content="{DynamicResource Music_FollowHours}" IsChecked="{Binding MusicFollowHours}" Margin="0,0,0,10" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding NextSongCommand}" IsEnabled="{Binding MusicIsPlaying}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE893;" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Music_Next}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding MusicStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Phone panel -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Web_Section}" Style="{StaticResource H2}" />
                    <TextBlock Text="{DynamicResource Web_Description}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Web_Pin}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="120" Text="{Binding NewWebPin, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" Margin="0,0,8,0" />
                                <Button Command="{Binding SaveWebPinCommand}" Content="{DynamicResource Web_SavePin}" />
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{DynamicResource Web_PinNotSet}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWebPin}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource Web_PinSet}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <CheckBox Content="{DynamicResource Web_Enabled}" IsChecked="{Binding WebPanelEnabled}" Margin="0,12,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Web_Port}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="80" Text="{Binding WebPanelPort, UpdateSourceTrigger=PropertyChanged, Delay=800}" />
                            </StackPanel>
                            <TextBlock Text="{Binding WebStatusText}" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding WebUrls}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas, Segoe UI" FontSize="14" Margin="0,0,0,4" HorizontalAlignment="Left" MinWidth="220" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource SmallButton}" Command="{Binding CopyWebUrlCommand}" HorizontalAlignment="Left" Content="{DynamicResource Web_CopyUrl}"
                                    Visibility="{Binding WebIsRunning, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{DynamicResource Web_FirewallNote}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="150" Height="150" Background="White" CornerRadius="8" Padding="10" Margin="16,0,0,0" VerticalAlignment="Top"
                                Visibility="{Binding WebQr, Converter={StaticResource NullToVis}}" ToolTip="{DynamicResource Web_QrHint}">
                            <ContentControl Content="{Binding WebQr}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Update_Section}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Secondary}" Margin="0,4,0,8" />
                    <Expander Header="{DynamicResource Update_WhatsNew}" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"
                              Visibility="{Binding ReleaseNotes, Converter={StaticResource NullToVis}}">
                        <Border Background="{DynamicResource ControlBrush}" CornerRadius="6" Padding="12,10" Margin="0,6,0,0" MaxHeight="260">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" FontSize="12.5" />
                            </ScrollViewer>
                        </Border>
                    </Expander>
                    <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Margin="0,0,0,10"
                                 Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolToVis}}" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button Command="{Binding CheckUpdatesNowCommand}" IsEnabled="{Binding IsUpdateBusy, Converter={StaticResource InvBool}}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Update_CheckNow}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding InstallUpdateCommand}" Margin="0,0,8,6"
                                Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Update_InstallNow}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenReleasePageCommand}" Margin="0,0,8,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Update_ReleaseNotes}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <CheckBox Content="{DynamicResource Update_AutoCheck}" IsChecked="{Binding CheckForUpdates}" Margin="0,0,0,10" />
                    <CheckBox Content="{DynamicResource Update_AutoInstall}" IsChecked="{Binding AutoInstallUpdates}" IsEnabled="{Binding CheckForUpdates}" />
                    <TextBlock Text="{DynamicResource Update_Hint}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="52,4,0,0" />
                </StackPanel>
            </Border>

            <!-- About / installation -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource General_SectionAbout}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding VersionText}" />
                    <TextBlock Text="{Binding LicenseText}" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding CopyrightText}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource SmallButton}" Content="{DynamicResource License_View}" Command="{Binding ViewLicenseCommand}" Margin="0,0,6,6" />
                        <Button Style="{StaticResource SmallButton}" Content="{DynamicResource License_Notices}" Command="{Binding ViewNoticesCommand}" Margin="0,0,6,6" />
                        <Button Style="{StaticResource SmallButton}" Content="{DynamicResource License_Source}" Command="{Binding OpenSourceCodeCommand}" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0">
                        <Run Text="{DynamicResource About_DataFolder}" /><Run Text=": " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0">
                        <Run Text="{DynamicResource About_ExePath}" /><Run Text=": " /><Run Text="{Binding ExePath, Mode=OneWay}" />
                    </TextBlock>
                    <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                            Visibility="{Binding IsInstalled, Converter={StaticResource InvBoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Install_NotInstalled}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="{DynamicResource Install_Button}"
                                    Command="{Binding InstallCommand}" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource General_OpenLogs}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CreateDiagnosticsCommand}" Margin="0,0,8,0" ToolTip="{DynamicResource Diagnostics_Hint}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Diagnostics_Create}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenDataFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource General_OpenData}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
