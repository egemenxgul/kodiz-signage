<UserControl x:Class="KodizSignage.Views.Tabs.ShortcutsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KodizSignage.ViewModels"
             xmlns:conv="clr-namespace:KodizSignage.Converters"
             xmlns:ctl="clr-namespace:KodizSignage.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="900" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Shortcuts_Title}" Style="{StaticResource H1}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding ResetAllCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Shortcut_ResetAll}" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Text="{DynamicResource Shortcuts_Description}" Style="{StaticResource Secondary}" Margin="0,8,0,4" MaxWidth="780" HorizontalAlignment="Left" />
            <TextBlock Text="{DynamicResource Shortcuts_Rules}" Style="{StaticResource Secondary}" Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12" Margin="0,0,0,18" MaxWidth="780" HorizontalAlignment="Left" />

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ShortcutItemViewModel}">
                        <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Icon -->
                                <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}"
                                        VerticalAlignment="Top" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="17" Foreground="{DynamicResource AccentHoverBrush}" />
                                </Border>

                                <!-- What it does -->
                                <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding DefaultText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Recording box -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBox Text="{Binding BoxText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                             Cursor="Hand" FontFamily="Consolas, Segoe UI" FontSize="14" HorizontalContentAlignment="Center"
                                             ToolTip="{DynamicResource Shortcut_ClickToChange}" ContextMenu="{x:Null}"
                                             GotKeyboardFocus="ShortcutBox_GotKeyboardFocus"
                                             LostKeyboardFocus="ShortcutBox_LostKeyboardFocus"
                                             PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                                             PreviewKeyUp="ShortcutBox_PreviewKeyUp">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Padding" Value="8,8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAssigned}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="{DynamicResource Shortcut_RecordHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!-- Row actions -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE777;" ToolTip="{DynamicResource Shortcut_Reset}"
                                            Command="{Binding ResetCommand}"
                                            IsEnabled="{Binding IsDefault, Converter={StaticResource InvBool}}" />
                                    <Button Style="{StaticResource DangerIconButton}" Content="&#xE711;" ToolTip="{DynamicResource Shortcut_Clear}"
                                            Command="{Binding ClearCommand}" IsEnabled="{Binding IsAssigned}" />
                                </StackPanel>

                                <!-- Status / error -->
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasError, Converter={StaticResource InvBoolToVis}}">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="InUse">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Invalid">
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding ErrorText}" FontSize="12" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
