<Window x:Class="KodizSignage.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kodiz Signage – Player"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Cursor="None"
        Background="Black"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="800" Height="450">
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid x:Name="LayerA" Opacity="0">
            <Image x:Name="ImageA" Stretch="Uniform" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <MediaElement x:Name="VideoA" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          Stretch="Uniform" IsMuted="True" Visibility="Collapsed" />
        </Grid>
        <Grid x:Name="LayerB" Opacity="0">
            <Image x:Name="ImageB" Stretch="Uniform" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <MediaElement x:Name="VideoB" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          Stretch="Uniform" IsMuted="True" Visibility="Collapsed" />
        </Grid>

        <!-- Clock, ticker, logo (above content and the empty state, below "closed"). -->
        <Grid x:Name="OverlayHost" Panel.ZIndex="15" IsHitTestVisible="False" />

        <!-- Outside opening hours: plain black. -->
        <Grid x:Name="ClosedState" Visibility="Collapsed" Opacity="0" Panel.ZIndex="20" Background="Black" />

        <!-- Shown when no item is active / within its date range. -->
        <Grid x:Name="EmptyState" Visibility="Collapsed" Opacity="0" Panel.ZIndex="10">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#1E2230" Offset="0" />
                    <GradientStop Color="#0B0D12" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>
            <Viewbox MaxWidth="900" Margin="80">
                <StackPanel HorizontalAlignment="Center" Width="600">
                    <Border Width="96" Height="96" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,28">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0" />
                                <GradientStop Color="#14B8A6" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M 0,0 L 26,16 L 0,32 Z" Fill="White" Margin="8,0,0,0"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{DynamicResource Player_NoContentTitle}" Foreground="White" FontSize="34"
                               FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" FontFamily="Segoe UI" />
                    <TextBlock Text="{DynamicResource Player_NoContentHint}" Foreground="#9AA3B2" FontSize="16"
                               Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" FontFamily="Segoe UI" />
                    <TextBlock x:Name="ShortcutHint" Foreground="#6B7385" FontSize="14" Margin="0,8,0,0"
                               HorizontalAlignment="Center" FontFamily="Segoe UI">
                        <Run Text="{DynamicResource Player_SettingsShortcut}" /><Run x:Name="ShortcutRun" FontWeight="SemiBold" Foreground="#C7CCD6" />
                    </TextBlock>
                </StackPanel>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
