<Window x:Class="KodizSignage.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KodizSignage.ViewModels"
        xmlns:conv="clr-namespace:KodizSignage.Converters"
        xmlns:ctl="clr-namespace:KodizSignage.Controls"
        xmlns:tabs="clr-namespace:KodizSignage.Views.Tabs"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="{DynamicResource Settings_Title}"
        Width="1280" Height="800" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico"
        AllowDrop="True"
        UseLayoutRounding="True">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="30" Height="30" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{DynamicResource App_Name}" Style="{StaticResource H1}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFallback}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Media.NowPlayingText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding PlacementText}" Margin="18,2,0,0" TextTrimming="CharacterEllipsis" FontSize="12"
                               Visibility="{Binding PlacementText, Converter={StaticResource NullToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFallback}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72E;" Click="Lock_Click" Margin="0,0,8,0" Width="38" Height="38"
                            ToolTip="{DynamicResource Pin_LockNow}" Visibility="{Binding General.HasPin, Converter={StaticResource BoolToVis}}" />
                    <Button Command="{Binding OpenAlertCommand}" Margin="0,0,8,0" ToolTip="{DynamicResource Alert_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE789;" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Alert_Button}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Media.PreviewCommand}" Margin="0,0,8,0" ToolTip="{DynamicResource Preview_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Preview_Button}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NextCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE893;" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Action_Next}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding TogglePlaybackCommand}" MinWidth="120">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Action_Start}" />
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Action_Stop}" />
                                                </StackPanel>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1">
        <!-- ===== Updated: what's new ===== -->
        <Border Background="{DynamicResource AccentSoftBrush}" Padding="24,10"
                Visibility="{Binding WhatsNewText, Converter={StaticResource NullToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding DismissWhatsNewCommand}" ToolTip="{DynamicResource Common_Close}" />
                <Button DockPanel.Dock="Right" Content="{DynamicResource WhatsNew_Show}" Command="{Binding ShowWhatsNewCommand}" Margin="0,0,8,0" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE789;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding WhatsNewText}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>
        <!-- ===== Active emergency notice ===== -->
        <Border Background="{DynamicResource DangerSoftBrush}" Padding="24,10"
                Visibility="{Binding AlertText, Converter={StaticResource NullToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Alert_Clear}" Command="{Binding ClearAlertCommand}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE789;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding AlertText}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <!-- ===== Safe mode banner ===== -->
        <Border Background="{DynamicResource WarningSoftBrush}" Padding="24,10"
                Visibility="{Binding SafeModeText, Converter={StaticResource NullToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding SafeModeText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding DismissSafeModeCommand}" ToolTip="{DynamicResource Common_Close}" />
            </Grid>
        </Border>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="2" Margin="0,4,0,0" SelectedIndex="{Binding SelectedTab}">

            <!-- ===================== LIBRARY ===================== -->
            <TabItem Header="{DynamicResource Tab_Library}" DataContext="{Binding Media}">
                <Grid Margin="24,16,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.42*" MinWidth="290" MaxWidth="380" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Grid Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentButton}" Command="{Binding AddFilesCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Media_AddFiles}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CreateSlideCommand}" Margin="0,0,8,0" ToolTip="{DynamicResource Slide_CreateHint}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Slide_CreateButton}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{DynamicResource Library_Hint}" Style="{StaticResource Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="&#xEDA2;" FontSize="12" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiskLow}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DiskText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0"
                                        Visibility="{Binding IsFolderSyncEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8F7;" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding FolderStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <!-- Search, filter, sort -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid MinWidth="200" Margin="0,0,8,0">
                                <TextBox x:Name="LibrarySearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{DynamicResource Library_Search}" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ComboBox ItemsSource="{Binding FilterChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Filter}"
                                      Grid.Column="1" Width="190" Margin="0,0,8,0" ToolTip="{DynamicResource Library_FilterTooltip}" />
                            <ComboBox ItemsSource="{Binding SortChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Sort}"
                                      Grid.Column="2" Width="170" ToolTip="{DynamicResource Library_SortTooltip}" />
                        </Grid>
                    </Grid>

                    <!-- New media goes to … -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding ShowScreens, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Library_AutoAddLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ItemsControl ItemsSource="{Binding AutoAddChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ScreenChipViewModel}">
                                        <ToggleButton Style="{StaticResource ScreenChip}" Tag="{Binding ColorBrush}" Content="{Binding Number}"
                                                      IsChecked="{Binding IsOn}" ToolTip="{Binding Name}" IsEnabled="{Binding IsLinked, Converter={StaticResource InvBool}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding AutoAddText}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Import progress -->
                    <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10"
                            Visibility="{Binding IsImporting, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImportStatus}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                <ProgressBar Value="{Binding ImportProgress}" Maximum="100" />
                            </StackPanel>
                            <Button Grid.Column="1" Margin="16,0,0,0" Content="{DynamicResource Media_Cancel}" Command="{Binding CancelImportCommand}" />
                        </Grid>
                    </Border>

                    <!-- List -->
                    <Grid Grid.Row="3" Margin="0,0,16,0">
                        <ListBox x:Name="MediaList" ItemsSource="{Binding ItemsView}"
                                 SelectedItem="{Binding SelectedItem}" SelectionMode="Extended"
                                 ItemContainerStyle="{StaticResource CardListItem}" AllowDrop="True"
                                 SelectionChanged="MediaList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="MediaList_PreviewMouseMove"
                                 DragOver="MediaList_DragOver" Drop="MediaList_Drop" KeyDown="MediaList_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MediaItemViewModel}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Tag="DragHandle" Style="{StaticResource Icon}" Background="Transparent" Padding="2,14" IsManipulationEnabled="True" Text="&#xE76F;" Foreground="{DynamicResource TextMutedBrush}"
                                                   Cursor="SizeAll" ToolTip="{DynamicResource Media_DragToReorder}"
                                                   Visibility="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}" />
                                        <Border Grid.Column="1" Width="96" Height="54" CornerRadius="4" Background="{DynamicResource MediaBgBrush}" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border Background="#AA000000" CornerRadius="3" Padding="4,1" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding VideoLength}" FontSize="10" Foreground="White" />
                                                </Border>
                                                <Border Background="#AA000000" CornerRadius="3" Padding="4,2" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Visibility="{Binding IsSlide, Converter={StaticResource BoolToVis}}" ToolTip="{DynamicResource Library_FilterSlides}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="10" Foreground="White" />
                                                </Border>
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="4,1" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Visibility="{Binding IsNowPlaying, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding OnAirText}" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0"
                                                           ToolTip="{DynamicResource Media_CompatTooltip}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalName}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding ScheduleSummary, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UsageText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- Screens using this media (click to add/remove; no copy is made) -->
                                        <ItemsControl Grid.Column="3" ItemsSource="{Binding ScreenChips}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                      Visibility="{Binding DataContext.ShowScreens, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ScreenChipViewModel}">
                                                    <ToggleButton Style="{StaticResource ScreenChip}" Tag="{Binding ColorBrush}" Content="{Binding Number}"
                                                                  IsChecked="{Binding IsOn}" ToolTip="{Binding Name}"
                                                                  IsEnabled="{Binding IsLinked, Converter={StaticResource InvBool}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <CheckBox Grid.Column="4" IsChecked="{Binding IsActive}" VerticalAlignment="Center" ToolTip="{DynamicResource Library_ActiveTooltip}" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="{DynamicResource Media_MoveUp}"
                                                    IsEnabled="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="{DynamicResource Media_MoveDown}"
                                                    IsEnabled="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource DangerIconButton}" Content="&#xE74D;" ToolTip="{DynamicResource Library_Delete}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="12"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="40" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{DynamicResource Media_EmptyTitle}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                                <TextBlock Text="{DynamicResource Media_EmptyHint}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Text="{DynamicResource Media_DropHint}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Details: library defaults / bulk -->
                    <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                            <Grid>
                                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}" Margin="0,40,0,0">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B3;" FontSize="28" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{DynamicResource Media_NoSelection}" Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,12,0,0" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowSingleDetails, Converter={StaticResource BoolToVis}}">
                                    <Border Height="170" CornerRadius="6" ClipToBounds="True"
                                            Background="{Binding DataContext.General.BackgroundColor, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ColorToBrush}}">
                                        <Grid>
                                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <MediaElement x:Name="PreviewVideo" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True" Stretch="Uniform"
                                                          MediaEnded="PreviewVideo_MediaEnded" />
                                        </Grid>
                                    </Border>

                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                                        <TextBlock Text="{DynamicResource Library_DefaultsInfo}" TextWrapping="Wrap" FontSize="12" />
                                    </Border>

                                    <Button Command="{Binding EditSlideCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Visibility="{Binding SelectedItem.IsSlide, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Slide_EditButton}" />
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{DynamicResource Media_Details_Name}" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding SelectedItem.DisplayName, UpdateSourceTrigger=PropertyChanged, Delay=700}" />
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{DynamicResource Media_Details_Original}" /><Run Text=": " /><Run Text="{Binding SelectedItem.OriginalName, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" ToolTip="{DynamicResource Stats_DetailsTooltip}">
                                        <Run Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" /><Run Text=" " /><Run Text="{Binding StatsText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                               Visibility="{Binding SelectedItem.IsVideo, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <Run Text="{DynamicResource Media_Details_Length}" /><Run Text=": " /><Run Text="{Binding SelectedItem.VideoLength, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding SelectedItem.VideoSize, Mode=OneWay}" />
                                    </TextBlock>
                                    <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                                            Visibility="{Binding SelectedItem.HasWarning, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <TextBlock Text="{DynamicResource Media_CompatTooltip}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
                                    </Border>

                                    <!-- Screens -->
                                    <StackPanel Visibility="{Binding ShowScreens, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Media_Screens}" Style="{StaticResource FieldLabel}" />
                                        <ItemsControl ItemsSource="{Binding SelectedItem.ScreenChips}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ScreenChipViewModel}">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="6" CornerRadius="3" Background="{Binding ColorBrush}" Margin="0,2,8,2" />
                                                        <CheckBox Grid.Column="1" Content="{Binding Name}" IsChecked="{Binding IsOn}"
                                                                  IsEnabled="{Binding IsLinked, Converter={StaticResource InvBool}}" />
                                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE76C;" ToolTip="{DynamicResource Library_OpenScreen}"
                                                                Command="{Binding DataContext.OpenScreenCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                CommandParameter="{Binding Number}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Library_DefaultActive}" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding SelectedItem.IsActive}" />
                                    </Grid>
                                    <StackPanel Visibility="{Binding SelectedItem.IsImage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                        <TextBlock Text="{DynamicResource Library_DefaultDuration}" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding SelectedItem.ImageDuration, UpdateSourceTrigger=PropertyChanged, Delay=700, TargetNullValue=''}"
                                                 ToolTip="{Binding DefaultDurationHint}" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Schedule_DatesTitle}" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <DatePicker SelectedDate="{Binding SelectedItem.StartDate}" ToolTip="{DynamicResource Media_Col_Start}" />
                                        <DatePicker Grid.Column="2" SelectedDate="{Binding SelectedItem.EndDate}" ToolTip="{DynamicResource Media_Col_End}" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Schedule_DatesHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Schedule_Title}" Style="{StaticResource FieldLabel}" />
                                    <ContentControl Content="{Binding SelectedItem.Schedule}" ContentTemplate="{StaticResource ScheduleEditorTemplate}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{DynamicResource Library_Delete}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel DataContext="{Binding Bulk}"
                                            Visibility="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                                    <TextBlock Text="{DynamicResource Bulk_Hint}" Style="{StaticResource Secondary}" FontSize="12" />
                                    <StackPanel Visibility="{Binding DataContext.ShowScreens, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{DynamicResource Media_Screens}" Style="{StaticResource FieldLabel}" />
                                        <ItemsControl ItemsSource="{Binding Screens}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:BulkScreenOption}">
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Margin="0,0,0,6" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <WrapPanel>
                                            <Button Style="{StaticResource SmallButton}" Content="{DynamicResource Bulk_SetScreens}" Command="{Binding SetScreensCommand}" Margin="0,0,6,6" />
                                            <Button Style="{StaticResource SmallButton}" Content="{DynamicResource Bulk_AddScreens}" Command="{Binding AddScreensCommand}" Margin="0,0,6,6" />
                                            <Button Style="{StaticResource SmallButton}" Content="{DynamicResource Bulk_RemoveScreens}" Command="{Binding RemoveScreensCommand}" Margin="0,0,6,6" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{DynamicResource Bulk_Activate}" Command="{Binding ActivateCommand}" Margin="0,0,6,0" />
                                        <Button Content="{DynamicResource Bulk_Deactivate}" Command="{Binding DeactivateCommand}" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Bulk_Duration}" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                        <Button Grid.Column="1" Content="{DynamicResource Bulk_Apply}" Command="{Binding ApplyDurationCommand}" Margin="6,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Schedule_DatesTitle}" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <DatePicker SelectedDate="{Binding StartDate}" />
                                        <DatePicker Grid.Column="2" SelectedDate="{Binding EndDate}" />
                                    </Grid>
                                    <Button Content="{DynamicResource Bulk_Apply}" Command="{Binding ApplyDatesCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                    <TextBlock Text="{DynamicResource Schedule_Title}" Style="{StaticResource FieldLabel}" />
                                    <ContentControl Content="{Binding Schedule}" ContentTemplate="{StaticResource ScheduleEditorTemplate}" />
                                    <Button Content="{DynamicResource Bulk_Apply}" Command="{Binding ApplyScheduleCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                    <Button Command="{Binding DeleteCommand}" HorizontalAlignment="Left" Margin="0,20,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" />
                                            <TextBlock Text="{DynamicResource Bulk_Delete}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== SCREENS ===================== -->
            <TabItem Header="{DynamicResource Tab_Display}" DataContext="{Binding Display}">
                <Grid Margin="24,16,24,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ===== Sidebar ===== -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                                <Button Style="{StaticResource SmallButton}" Command="{Binding IdentifyCommand}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{DynamicResource Display_Identify}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" ToolTip="{DynamicResource Display_Refresh}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" />
                                </Button>
                            </StackPanel>
                            <Border Padding="10,8" CornerRadius="6" Margin="0,0,0,10" Background="{DynamicResource WarningSoftBrush}"
                                    Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" />
                            </Border>
                        </StackPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListItem}">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScreenCardViewModel}">
                                    <Grid x:Name="Root">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="5" CornerRadius="2" Background="{Binding ColorBrush}" Margin="0,0,10,0" x:Name="Stripe" />
                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" CornerRadius="6" Background="{Binding ColorBrush}" Margin="0,0,8,0" x:Name="BadgeBox">
                                                    <TextBlock Text="{Binding Badge}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}" ToolTip="{DynamicResource Screen_ShowHere}" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="54" Height="30" CornerRadius="3" Background="{DynamicResource MediaBgBrush}" ClipToBounds="True" Margin="0,0,8,0"
                                                        Visibility="{Binding NowPlayingThumbnail, Converter={StaticResource NullToVis}}">
                                                    <Image Source="{Binding NowPlayingThumbnail}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                                                    <TextBlock Text="{Binding MediaText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding LinkText}" FontSize="11" Foreground="{DynamicResource AccentHoverBrush}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding LinkText, Converter={StaticResource NullToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding Hardware}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasConfig}" Value="False">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter TargetName="BadgeBox" Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Settings for all screens -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Screens_AllTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource Fallback_Title}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding FallbackOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Fallback}"
                                          ToolTip="{DynamicResource Fallback_Description}" />
                                <TextBlock Text="{DynamicResource Audio_Title}" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                                <ComboBox ItemsSource="{Binding AudioOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AudioScreen}" />
                                <CheckBox Content="{DynamicResource Performance_Preload}" IsChecked="{Binding PreloadVideos}" Margin="0,10,0,0"
                                          ToolTip="{DynamicResource Performance_PreloadHint}" />
                                <TextBlock Text="{Binding PerformanceWarning}" FontSize="11.5" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding PerformanceWarning, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== Unused display selected ===== -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding IsUnusedDisplaySelected, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="36" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedCard.Title}" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedCard.Hardware}" Style="{StaticResource Secondary}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="{DynamicResource Screen_UnusedHint}" Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,12,0,16" />
                            <Button Style="{StaticResource AccentButton}" Command="{Binding UseSelectedDisplayCommand}" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                    <TextBlock Text="{DynamicResource Screen_ShowHere}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- ===== Editor of the selected screen ===== -->
                    <Grid Grid.Column="2" DataContext="{Binding Editor}" Visibility="{Binding HasScreen, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Colored header: which screen is being edited -->
                        <Border Background="{Binding SoftBrush}" BorderBrush="{Binding ColorBrush}" BorderThickness="6,0,0,0" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="10" Background="{Binding ColorBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Number}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding HardwareText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <CheckBox Content="{DynamicResource Screen_ShowHere}" IsChecked="{Binding IsEnabled}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SmallButton}" Command="{Binding PreviewCommand}" Margin="0,0,6,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="12" Margin="0,0,6,0" />
                                                <TextBlock Text="{DynamicResource Preview_Button}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource SmallButton}" Command="{Binding IdentifyCommand}" ToolTip="{DynamicResource Display_Identify}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="1" Margin="-24,0,0,0">
                            <!-- Playlist of this screen -->
                            <TabItem Header="{DynamicResource Editor_TabPlaylist}">
                                <Grid Margin="24,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.45*" MinWidth="280" MaxWidth="360" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Playlist source / options + time-of-day lists -->
                                    <StackPanel Grid.ColumnSpan="2">
                                    <WrapPanel Margin="0,0,0,8">
                                        <ComboBox ItemsSource="{Binding LinkOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LinkChoice}"
                                                  MinWidth="230" Margin="0,0,10,6" ToolTip="{DynamicResource Editor_LinkHint}" />
                                        <CheckBox Content="{DynamicResource Editor_Synchronized}" IsChecked="{Binding Synchronized}" Margin="0,6,16,6"
                                                  ToolTip="{DynamicResource Editor_SynchronizedHint}" Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}" />
                                        <CheckBox Content="{DynamicResource Editor_AutoAdd}" IsChecked="{Binding AutoAddNewMedia}" Margin="0,6,16,6"
                                                  Visibility="{Binding IsLinked, Converter={StaticResource InvBoolToVis}}" />
                                    </WrapPanel>

                                    <!-- Time-of-day lists: Main | Breakfast 08–12 | Lunch 12–17 | + -->
                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                            Padding="10,8" Margin="0,0,0,10" Visibility="{Binding IsLinked, Converter={StaticResource InvBoolToVis}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveListText}" VerticalAlignment="Center" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" />
                                                <WrapPanel>
                                                    <ItemsControl ItemsSource="{Binding Lists}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:DaypartOption}">
                                                                <Button Margin="0,0,6,6" Padding="12,5" MinHeight="38" ToolTip="{Binding Detail}"
                                                                        Command="{Binding DataContext.SelectListCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding Key}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                 Visibility="{Binding IsPlayingNow, Converter={StaticResource BoolToVis}}" />
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Command="{Binding AddDaypartCommand}" Margin="0,0,6,6" MinHeight="38" ToolTip="{DynamicResource Daypart_AddHint}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                                            <TextBlock Text="{DynamicResource Daypart_Add}" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </DockPanel>
                                            <!-- Selected time-of-day list: name, days, hours -->
                                            <Grid Margin="0,6,0,0" Visibility="{Binding IsDaypartSelected, Converter={StaticResource BoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock Text="{DynamicResource Daypart_Name}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding DaypartName, UpdateSourceTrigger=PropertyChanged, Delay=700}" />
                                                    <TextBlock Text="{DynamicResource Daypart_Explain}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                                <ContentControl Grid.Column="1" Content="{Binding DaypartSchedule}" ContentTemplate="{StaticResource ScheduleEditorTemplate}" />
                                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                                    <Button Command="{Binding CopyMainToDaypartCommand}" Content="{DynamicResource Daypart_CopyMain}" Margin="0,0,0,6" />
                                                    <Button Command="{Binding RemoveDaypartCommand}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,0" />
                                                            <TextBlock Text="{DynamicResource Daypart_Remove}" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,8"
                                                Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding LinkedText}" TextWrapping="Wrap" />
                                        </Border>
                                        <WrapPanel Visibility="{Binding IsLinked, Converter={StaticResource InvBoolToVis}}">
                                            <Button Style="{StaticResource AccentButton}" Command="{Binding AddFromLibraryCommand}" Margin="0,0,8,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Editor_AddFromLibrary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding AddFilesCommand}" Margin="0,0,8,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Editor_AddFiles}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding CreateSlideCommand}" Margin="0,0,8,6" ToolTip="{DynamicResource Slide_CreateHint}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="0,0,8,0" />
                                                    <TextBlock Text="{DynamicResource Slide_CreateButton}" />
                                                </StackPanel>
                                            </Button>
                                            <ComboBox ItemsSource="{Binding CopySources}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CopySourceChoice}"
                                                      MinWidth="200" Margin="0,0,8,6" />
                                            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,6" />
                                        </WrapPanel>
                                    </Grid>

                                    <!-- Entries -->
                                    <Grid Grid.Row="2" Margin="0,0,16,0">
                                        <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" SelectionMode="Extended"
                                                 ItemContainerStyle="{StaticResource CardListItem}" AllowDrop="True" IsEnabled="{Binding CanEditEntries}"
                                                 SelectionChanged="EntryList_SelectionChanged"
                                                 PreviewMouseLeftButtonDown="EntryList_PreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="EntryList_PreviewMouseMove"
                                                 DragOver="EntryList_DragOver" Drop="EntryList_Drop" KeyDown="EntryList_KeyDown">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                                                    <Grid x:Name="Row">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="80" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Tag="DragHandle" Style="{StaticResource Icon}" Background="Transparent" Padding="2,14" IsManipulationEnabled="True" Text="&#xE76F;" Foreground="{DynamicResource TextMutedBrush}" Cursor="SizeAll"
                                                                   ToolTip="{DynamicResource Media_DragToReorder}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Position, Converter={StaticResource PlusOne}}" Foreground="{DynamicResource TextMutedBrush}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" />
                                                        <Border Grid.Column="2" Width="80" Height="45" CornerRadius="4" Background="{DynamicResource MediaBgBrush}" ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="3,0" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                        Visibility="{Binding IsNowPlaying, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{DynamicResource Media_OnAir}" FontSize="9" Foreground="White" FontWeight="SemiBold" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                                                        Visibility="{Binding HasOverrides, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{DynamicResource Entry_ScreenSpecific}" FontSize="10.5" Foreground="{DynamicResource AccentHoverBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ScheduleSummary}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <!-- Duration on this screen -->
                                                        <Grid Grid.Column="4" Width="90" Margin="0,0,8,0" VerticalAlignment="Center"
                                                              Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvBoolToVis}}">
                                                            <Grid Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                                                                <TextBox x:Name="EntryDuration" Text="{Binding DurationOverride, UpdateSourceTrigger=PropertyChanged, Delay=700, TargetNullValue=''}"
                                                                         ToolTip="{Binding DurationDefaultText}" />
                                                                <TextBlock IsHitTestVisible="False" Margin="8,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                                                           Text="{Binding EffectiveDurationText}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Text, ElementName=EntryDuration}" Value="">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                            <TextBlock Text="{Binding VideoLength}" VerticalAlignment="Center" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                        <CheckBox Grid.Column="5" IsChecked="{Binding IsActive}" VerticalAlignment="Center" ToolTip="{DynamicResource Entry_ActiveTooltip}" Margin="0,0,8,0" />
                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="{DynamicResource Media_MoveUp}"
                                                                    Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="{DynamicResource Media_MoveDown}"
                                                                    Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="{DynamicResource Editor_Duplicate}"
                                                                    Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                            <Button Style="{StaticResource DangerIconButton}" Content="&#xE711;" ToolTip="{DynamicResource Editor_Remove}"
                                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayableNow}" Value="False">
                                                            <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="12" IsHitTestVisible="False"
                                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;" FontSize="36" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{DynamicResource Editor_EmptyTitle}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                                                <TextBlock Text="{DynamicResource Editor_EmptyHint}" Style="{StaticResource Secondary}" TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Entry details / bulk -->
                                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                                            <Grid>
                                                <TextBlock Text="{DynamicResource Editor_NoSelection}" Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,40,0,0"
                                                           Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}" />

                                                <StackPanel Visibility="{Binding ShowSingleDetails, Converter={StaticResource BoolToVis}}">
                                                    <Border Height="150" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource MediaBgBrush}">
                                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectedEntry.Title}" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" />
                                                    <Border Background="{Binding SoftBrush}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                                        <TextBlock Text="{DynamicResource Entry_OverrideInfo}" TextWrapping="Wrap" FontSize="12" />
                                                    </Border>

                                                    <!-- Active -->
                                                    <Grid Margin="0,14,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource Entry_ActiveHere}" />
                                                            <TextBlock Text="{Binding SelectedEntry.ActiveDefaultText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource ResetButton}" Command="{Binding SelectedEntry.ResetActiveCommand}" ToolTip="{DynamicResource Entry_Reset}"
                                                                Visibility="{Binding SelectedEntry.HasActiveOverride, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                                                        <CheckBox Grid.Column="2" IsChecked="{Binding SelectedEntry.IsActive}" VerticalAlignment="Center" />
                                                    </Grid>

                                                    <!-- Duration -->
                                                    <StackPanel Visibility="{Binding SelectedEntry.IsImage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                        <TextBlock Text="{DynamicResource Entry_DurationHere}" Style="{StaticResource FieldLabel}" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding SelectedEntry.DurationOverride, UpdateSourceTrigger=PropertyChanged, Delay=700, TargetNullValue=''}" />
                                                            <Button Grid.Column="1" Style="{StaticResource ResetButton}" Command="{Binding SelectedEntry.ResetDurationCommand}" ToolTip="{DynamicResource Entry_Reset}"
                                                                    Visibility="{Binding SelectedEntry.HasDurationOverride, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding SelectedEntry.DurationDefaultText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <!-- Transition -->
                                                    <TextBlock Text="{DynamicResource Entry_TransitionHere}" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding EntryTransitionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                              SelectedValue="{Binding SelectedEntry.TransitionChoice}" />

                                                    <!-- Dates -->
                                                    <CheckBox Content="{DynamicResource Entry_OwnDates}" IsChecked="{Binding SelectedEntry.OverrideDates}" Margin="0,14,0,4" />
                                                    <TextBlock Text="{Binding SelectedEntry.DatesDefaultText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                                                    <Grid IsEnabled="{Binding SelectedEntry.OverrideDates, FallbackValue=False}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <DatePicker SelectedDate="{Binding SelectedEntry.StartDate}" />
                                                        <DatePicker Grid.Column="2" SelectedDate="{Binding SelectedEntry.EndDate}" />
                                                    </Grid>

                                                    <!-- Days / hours -->
                                                    <CheckBox Content="{DynamicResource Entry_OwnSchedule}" IsChecked="{Binding SelectedEntry.OverrideSchedule}" Margin="0,14,0,4" />
                                                    <TextBlock Text="{Binding SelectedEntry.ScheduleDefaultText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
                                                    <ContentControl Content="{Binding SelectedEntry.Schedule}" ContentTemplate="{StaticResource ScheduleEditorTemplate}"
                                                                    IsEnabled="{Binding SelectedEntry.OverrideSchedule, FallbackValue=False}" />

                                                    <WrapPanel Margin="0,16,0,0">
                                                        <Button Style="{StaticResource SmallButton}" Command="{Binding SelectedEntry.ResetAllCommand}" Margin="0,0,6,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="12" Margin="0,0,6,0" />
                                                                <TextBlock Text="{DynamicResource Entry_ResetAll}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource SmallButton}" Command="{Binding RemoveCommand}" CommandParameter="{Binding SelectedEntry}" Margin="0,0,6,6">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0" />
                                                                <TextBlock Text="{DynamicResource Editor_Remove}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Bulk -->
                                                <StackPanel Visibility="{Binding IsMultiSelect, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{DynamicResource Editor_BulkTitle}" Style="{StaticResource H2}" />
                                                    <TextBlock Text="{DynamicResource Editor_BulkHint}" Style="{StaticResource Secondary}" FontSize="12" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                        <Button Content="{DynamicResource Bulk_Activate}" Command="{Binding BulkActivateCommand}" Margin="0,0,6,0" />
                                                        <Button Content="{DynamicResource Bulk_Deactivate}" Command="{Binding BulkDeactivateCommand}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{DynamicResource Bulk_Duration}" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding BulkDuration, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                                        <Button Grid.Column="1" Content="{DynamicResource Bulk_Apply}" Command="{Binding BulkApplyDurationCommand}" Margin="6,0,0,0" />
                                                    </Grid>
                                                    <TextBlock Text="{DynamicResource Schedule_DatesTitle}" Style="{StaticResource FieldLabel}" />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <DatePicker SelectedDate="{Binding BulkStartDate}" />
                                                        <DatePicker Grid.Column="2" SelectedDate="{Binding BulkEndDate}" />
                                                    </Grid>
                                                    <Button Content="{DynamicResource Bulk_Apply}" Command="{Binding BulkApplyDatesCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                                    <TextBlock Text="{DynamicResource Schedule_Title}" Style="{StaticResource FieldLabel}" />
                                                    <ContentControl Content="{Binding BulkSchedule}" ContentTemplate="{StaticResource ScheduleEditorTemplate}" />
                                                    <Button Content="{DynamicResource Bulk_Apply}" Command="{Binding BulkApplyScheduleCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                                    <WrapPanel Margin="0,18,0,0">
                                                        <Button Style="{StaticResource SmallButton}" Content="{DynamicResource Entry_ResetAll}" Command="{Binding ResetSelectedCommand}" Margin="0,0,6,6" />
                                                        <Button Style="{StaticResource SmallButton}" Content="{DynamicResource Editor_RemoveSelected}" Command="{Binding RemoveCommand}" Margin="0,0,6,6" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- Settings of this screen -->
                            <TabItem Header="{DynamicResource Editor_TabSettings}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="24,12,8,8" MaxWidth="720" HorizontalAlignment="Left">
                                        <TextBlock Text="{DynamicResource Editor_SettingsInfo}" Style="{StaticResource Secondary}" Margin="0,0,0,12" />

                                        <!-- Identity -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Editor_Identity}" Style="{StaticResource H2}" />
                                                <TextBlock Text="{DynamicResource Screen_NameHint}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=700}" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                                                <TextBlock Text="{Binding HardwareText}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,10" />
                                                <Button Style="{StaticResource SmallButton}" HorizontalAlignment="Left"
                                                        Command="{Binding ForgetCommand}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Foreground="{DynamicResource DangerBrush}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{DynamicResource Screen_Forget}" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Appearance -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="260" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource General_SectionAppearance}" Style="{StaticResource H2}" />
                                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                                    <TextBlock Text="{DynamicResource Rotation_Title}" />
                                                    <TextBlock Text="{DynamicResource Rotation_Hint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RotationChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding RotationChoice}" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="2" Text="{DynamicResource General_Scaling}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ScalingChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding ScalingChoice}" Margin="0,0,0,10" />
                                                <CheckBox Grid.Row="3" Content="{DynamicResource Screen_OwnBackground}" IsChecked="{Binding HasOwnBackground}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding HasOwnBackground}">
                                                    <ctl:ColorPicker Color="{Binding BackgroundColor}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Playback -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="260" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource General_SectionPlayback}" Style="{StaticResource H2}" />
                                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                                    <CheckBox Content="{DynamicResource Editor_OwnDuration}" IsChecked="{Binding HasOwnDuration}" />
                                                    <TextBlock Text="{Binding GeneralDurationText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="52,2,0,0" />
                                                </StackPanel>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DefaultDuration, UpdateSourceTrigger=PropertyChanged, Delay=700}"
                                                         IsEnabled="{Binding HasOwnDuration}" VerticalAlignment="Top" />
                                                <TextBlock Grid.Row="2" Text="{DynamicResource General_Transition}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TransitionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding TransitionChoice}" Margin="0,0,0,10" />
                                                <TextBlock Grid.Row="4" Text="{DynamicResource Motion_Title}" VerticalAlignment="Center" Margin="0,10,0,0" />
                                                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding MotionChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding MotionChoice}" Margin="0,10,0,0" />
                                                <CheckBox Grid.Row="3" Content="{DynamicResource Editor_OwnTransitionDuration}" IsChecked="{Binding HasOwnTransitionDuration}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding HasOwnTransitionDuration}">
                                                    <Slider Width="190" Minimum="0.1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding TransitionDuration}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TransitionDuration, StringFormat={}{0:0.0} s}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Sound -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="260" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource General_SectionAudio}" Style="{StaticResource H2}" />
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding AudioNote}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                           Visibility="{Binding AudioNote, Converter={StaticResource NullToVis}}" />
                                                <TextBlock Grid.Row="2" Text="{DynamicResource General_VideoSound}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SoundChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                          SelectedValue="{Binding SoundChoice}" Margin="0,0,0,10" />
                                                <CheckBox Grid.Row="3" Content="{DynamicResource Editor_OwnVolume}" IsChecked="{Binding HasOwnVolume}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding HasOwnVolume}">
                                                    <Slider Width="190" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding VolumePercent}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding VolumePercent, StringFormat={}{0:0} %}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Opening hours -->
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Hours_Title}" Style="{StaticResource H2}" />
                                                <CheckBox Content="{DynamicResource Editor_OwnHours}" IsChecked="{Binding HasOwnHours}" Margin="0,0,0,4" />
                                                <TextBlock Text="{DynamicResource Editor_OwnHoursHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                                <StackPanel IsEnabled="{Binding HasOwnHours}">
                                                    <CheckBox Content="{DynamicResource Hours_Enabled}" IsChecked="{Binding HoursEnabled}" Margin="0,0,0,10" />
                                                    <ContentControl Content="{Binding Hours.Editor}" ContentTemplate="{StaticResource ScheduleEditorTemplate}" MaxWidth="420" HorizontalAlignment="Left"
                                                                    IsEnabled="{Binding HoursEnabled}" />
                                                    <CheckBox Content="{DynamicResource Hours_AllowDisplaySleep}" IsChecked="{Binding HoursAllowDisplaySleep}" Margin="0,10,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Clock / ticker / logo of this screen -->
                            <TabItem Header="{DynamicResource Overlay_Tab}" DataContext="{Binding Overlays}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="24,12,8,8" MaxWidth="720" HorizontalAlignment="Left">
                                        <TextBlock Text="{DynamicResource Overlay_Info}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                        <!-- Clock -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Overlay_Clock}" Style="{StaticResource H2}" />
                                                <CheckBox Content="{DynamicResource Overlay_ClockEnabled}" IsChecked="{Binding ClockEnabled}" Margin="0,0,0,10" />
                                                <StackPanel IsEnabled="{Binding ClockEnabled}">
                                                    <TextBlock Text="{DynamicResource Overlay_Position}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                    <ComboBox ItemsSource="{Binding Corners}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClockCorner}"
                                                              Width="260" HorizontalAlignment="Left" />
                                                    <CheckBox Content="{DynamicResource Overlay_ClockDate}" IsChecked="{Binding ClockShowDate}" Margin="0,10,0,0" />
                                                    <CheckBox Content="{DynamicResource Overlay_ClockSeconds}" IsChecked="{Binding ClockShowSeconds}" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Ticker -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Overlay_Ticker}" Style="{StaticResource H2}" />
                                                <CheckBox Content="{DynamicResource Overlay_TickerEnabled}" IsChecked="{Binding TickerEnabled}" Margin="0,0,0,10" />
                                                <StackPanel IsEnabled="{Binding TickerEnabled}">
                                                    <TextBlock Text="{DynamicResource Overlay_TickerText}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding TickerText, UpdateSourceTrigger=PropertyChanged, Delay=700}" />
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200" />
                                                            <ColumnDefinition Width="20" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource Overlay_Position}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                            <ComboBox ItemsSource="{Binding TickerPositions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TickerPosition}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4">
                                                                <Run Text="{DynamicResource Overlay_TickerSpeed}" /><Run Text=": " /><Run Text="{Binding TickerSpeed, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <Slider Minimum="30" Maximum="400" SmallChange="10" LargeChange="40" TickFrequency="10" IsSnapToTickEnabled="True"
                                                                    Value="{Binding TickerSpeed, Delay=300}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="24" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource Overlay_TickerBackground}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ctl:ColorPicker Grid.Column="1" Grid.ColumnSpan="2" Color="{Binding TickerBackground}" />
                                                        <TextBlock Grid.Column="4" Text="{DynamicResource Overlay_TickerTextColor}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <ctl:ColorPicker Grid.Column="5" Grid.ColumnSpan="2" Color="{Binding TickerTextColor}" />
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Logo -->
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Overlay_Logo}" Style="{StaticResource H2}" />
                                                <TextBlock Text="{DynamicResource Overlay_LogoHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                <ComboBox ItemsSource="{Binding LogoChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding LogoId}"
                                                          Width="360" HorizontalAlignment="Left" />
                                                <StackPanel IsEnabled="{Binding HasLogo}" Margin="0,10,0,0">
                                                    <TextBlock Text="{DynamicResource Overlay_Position}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                                    <ComboBox ItemsSource="{Binding Corners}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding LogoCorner}"
                                                              Width="260" HorizontalAlignment="Left" />
                                                    <TextBlock Style="{StaticResource FieldLabel}">
                                                        <Run Text="{DynamicResource Overlay_LogoSize}" /><Run Text=": %" /><Run Text="{Binding LogoSize, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <Slider Minimum="4" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LogoSize, Delay=300}" MaxWidth="360" HorizontalAlignment="Stretch" />
                                                    <TextBlock Style="{StaticResource FieldLabel}">
                                                        <Run Text="{DynamicResource Overlay_LogoOpacity}" /><Run Text=": %" /><Run Text="{Binding LogoOpacityPercent, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding LogoOpacityPercent, Delay=300}" MaxWidth="360" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== GENERAL ===================== -->
            <TabItem Header="{DynamicResource Tab_General}" DataContext="{Binding General}">
                <tabs:GeneralTab />
            </TabItem>

            <!-- ===================== SHORTCUTS ===================== -->
            <TabItem Header="{DynamicResource Tab_Shortcuts}" DataContext="{Binding Shortcuts}">
                <tabs:ShortcutsTab />
            </TabItem>
        </TabControl>

        <!-- ===== Undo snackbar ===== -->
        <Border Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16,8"
                Visibility="{Binding Undo.IsVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Undo.Text}" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="520" TextTrimming="CharacterEllipsis" />
                <Button Style="{StaticResource AccentButton}" Content="{DynamicResource Media_Undo}" Command="{Binding Undo.UndoCommand}" MinHeight="30" Padding="12,4" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding Undo.CommitCommand}" Margin="6,0,0,0" ToolTip="{DynamicResource Common_Close}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
