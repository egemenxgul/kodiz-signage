<Window x:Class="KodizSignage.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Pin_Title}"
        Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="28" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,12" />
        <TextBlock x:Name="PromptText" Style="{StaticResource H2}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <PasswordBox x:Name="PinBox" FontSize="22" HorizontalContentAlignment="Center" Margin="0,4,0,8" MaxLength="12"
                     Background="{StaticResource ControlBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                     CaretBrush="{StaticResource TextBrush}" Padding="8" PasswordChanged="PinBox_PasswordChanged" KeyDown="PinBox_KeyDown" />
        <PasswordBox x:Name="ConfirmBox" FontSize="22" HorizontalContentAlignment="Center" Margin="0,0,0,8" MaxLength="12" Visibility="Collapsed"
                     Background="{StaticResource ControlBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"
                     CaretBrush="{StaticResource TextBrush}" Padding="8" KeyDown="PinBox_KeyDown" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button x:Name="OkButton" Content="{DynamicResource Common_Ok}" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="90" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
