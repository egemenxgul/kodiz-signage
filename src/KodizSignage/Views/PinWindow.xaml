<Window x:Class="KodizSignage.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Pin_Title}"
        Width="360" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="pack://application:,,,/Assets/app.ico">
    <StackPanel Margin="24">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="28" Foreground="{DynamicResource AccentHoverBrush}" Margin="0,0,0,12" />
        <TextBlock x:Name="PromptText" Style="{StaticResource H2}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <PasswordBox x:Name="PinBox" FontSize="22" HorizontalContentAlignment="Center" Margin="0,4,0,8" MaxLength="12"
                     Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                     CaretBrush="{DynamicResource TextBrush}" Padding="8" PasswordChanged="PinBox_PasswordChanged" KeyDown="PinBox_KeyDown" />
        <PasswordBox x:Name="ConfirmBox" FontSize="22" HorizontalContentAlignment="Center" Margin="0,0,0,8" MaxLength="12" Visibility="Collapsed"
                     Background="{DynamicResource ControlBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                     CaretBrush="{DynamicResource TextBrush}" Padding="8" KeyDown="PinBox_KeyDown" />
        <!-- Number pad for touch screens without a keyboard. -->
        <UniformGrid Columns="3" Margin="0,4,0,4">
            <UniformGrid.Resources>
                <Style x:Key="PinKey" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Height" Value="52" />
                    <Setter Property="Margin" Value="3" />
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </UniformGrid.Resources>
            <Button Content="1" Click="Digit_Click" Style="{StaticResource PinKey}" />
            <Button Content="2" Click="Digit_Click" Style="{StaticResource PinKey}" />
            <Button Content="3" Click="Digit_Click" Style="{StaticResource PinKey}" />
            <Button Content="4" Click="Digit_Click" Style="{StaticResource PinKey}" />
            <Button Content="5" Click="Digit_Click" Style="{StaticResource PinKey}" />
            <Button Content="6" Click="Digit_Click" Style="{StaticResource PinKey}" />
            <Button Content="7" Click="Digit_Click" Style="{StaticResource PinKey}" />
            <Button Content="8" Click="Digit_Click" Style="{StaticResource PinKey}" />
            <Button Content="9" Click="Digit_Click" Style="{StaticResource PinKey}" />
            <Button Click="Backspace_Click" Style="{StaticResource PinKey}" FontFamily="{StaticResource IconFont}" Content="&#xE750;" />
            <Button Content="0" Click="Digit_Click" Style="{StaticResource PinKey}" />
            <Button Click="Ok_Click" Style="{StaticResource PinKey}" FontFamily="{StaticResource IconFont}" Content="&#xE73E;"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" />
        </UniformGrid>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource Common_Cancel}" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button x:Name="OkButton" Content="{DynamicResource Common_Ok}" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="90" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
