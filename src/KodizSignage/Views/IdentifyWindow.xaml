<Window x:Class="KodizSignage.Views.IdentifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Identify"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="#B0000000" Width="400" Height="300">
    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="32" Padding="72,24"
                Background="#E61E2230" BorderBrush="#4F46E5" BorderThickness="4">
            <StackPanel>
                <TextBlock x:Name="NumberText" Text="1" FontSize="220" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" FontFamily="Segoe UI" />
                <TextBlock x:Name="DetailText" FontSize="28" Foreground="#C7CCD6" HorizontalAlignment="Center"
                           FontFamily="Segoe UI" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
