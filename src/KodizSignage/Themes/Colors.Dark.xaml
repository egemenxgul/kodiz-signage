<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme colors. Keys must match Colors.Dark.xaml / Colors.Light.xaml. -->
    <Color x:Key="BgColor">#0F1117</Color>
    <Color x:Key="SurfaceColor">#171A22</Color>
    <Color x:Key="SurfaceRaisedColor">#1F232D</Color>
    <Color x:Key="ControlColor">#262B36</Color>
    <Color x:Key="ControlHoverColor">#2F3542</Color>
    <Color x:Key="BorderColor">#323846</Color>
    <Color x:Key="TextColor">#E8EAF0</Color>
    <Color x:Key="TextSecondaryColor">#9AA3B2</Color>
    <Color x:Key="TextMutedColor">#6B7385</Color>
    <Color x:Key="AccentColor">#6366F1</Color>
    <Color x:Key="AccentHoverColor">#7C7FF5</Color>
    <Color x:Key="AccentSoftColor">#296366F1</Color>
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="SuccessSoftColor">#2622C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSoftColor">#26F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DangerSoftColor">#26EF4444</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="MediaBgColor">#0B0D12</Color>
    <Color x:Key="KnobColor">#9AA3B2</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="MediaBgBrush" Color="{StaticResource MediaBgColor}" />
    <SolidColorBrush x:Key="KnobBrush" Color="{StaticResource KnobColor}" />
    <SolidColorBrush x:Key="ShadowBrush" Color="{StaticResource ShadowColor}" />
</ResourceDictionary>
